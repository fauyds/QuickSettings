<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_full_qs_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="2dp"
    android:paddingBottom="8dp">

    <!-- Oreo Top Status Bar Row (Carrier on Left, Battery % + Icon + Time on Right) -->
    <LinearLayout
        android:id="@+id/ll_oreo_top_status_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tv_oreo_top_carrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Carrier"
            android:textColor="#FF444444"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_oreo_top_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="100%"
                android:textColor="#FF444444"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_oreo_top_battery_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Battery"
                android:src="@drawable/ic_qs_battery" />

            <TextView
                android:id="@+id/tv_oreo_top_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21:25"
                android:textColor="#FF444444"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Oreo Top Brightness Slider Row (Full-width bar with brightness icon at right) -->
    <LinearLayout
        android:id="@+id/ll_qs_top_brightness_row"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
            android:id="@+id/sb_qs_top_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:min="5"
            android:paddingHorizontal="4dp"
            android:progress="128" />

        <FrameLayout
            android:id="@+id/fl_qs_top_brightness_icon_pill"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/iv_qs_top_brightness_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Brightness"
                android:src="@drawable/ic_qs_brightness_high" />
        </FrameLayout>

        <!-- Hidden percentage text for ID parity -->
        <TextView
            android:id="@+id/tv_qs_top_brightness_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="50%" />
    </LinearLayout>

    <!-- Oreo Header Subheader (Hidden in expanded QS mode) -->
    <LinearLayout
        android:id="@+id/ll_qs_oreo_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_qs_oreo_header_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wednesday, Oct 25"
            android:textColor="#FF444444"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_qs_oreo_header_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:visibility="gone"
            android:text="|"
            android:textColor="#88888888"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/iv_qs_oreo_weather_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Weather"
            android:visibility="gone"
            android:src="@drawable/ic_qs_dark_mode" />

        <TextView
            android:id="@+id/tv_qs_oreo_weather_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="19 °C"
            android:textColor="#FF666666"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Tiles Paged Grid RecyclerView (3x3 grid) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_qs_tiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <!-- Tile Bottom Divider Line -->
    <View
        android:id="@+id/v_qs_oreo_tiles_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="#33888888" />

    <!-- Bottom Brightness Slider Row (Hidden, for exact ID parity) -->
    <LinearLayout
        android:id="@+id/ll_qs_bottom_brightness_row"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/fl_qs_bottom_brightness_icon_pill"
            android:layout_width="32dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/iv_qs_bottom_brightness_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_qs_brightness_low" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/sb_qs_bottom_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_qs_bottom_brightness_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%" />
    </LinearLayout>

    <!-- Oreo Footer Controls Row: Date on Left, Page Indicators in Center, Actions on Right -->
    <RelativeLayout
        android:id="@+id/rl_qs_footer_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingVertical="4dp">

        <!-- Left: Date indicator -->
        <TextView
            android:id="@+id/tv_qs_oreo_footer_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Wed, Oct 25"
            android:textColor="#FF666666"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Center: Page Indicator Dots -->
        <LinearLayout
            android:id="@+id/ll_qs_page_indicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- Right: Action Buttons (Edit, Settings, Collapse ▲, Power) -->
        <LinearLayout
            android:id="@+id/ll_qs_footer_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_qs_edit_mode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Tiles"
                android:padding="6dp"
                android:src="@drawable/ic_qs_edit" />

            <ImageView
                android:id="@+id/btn_qs_settings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="System Settings"
                android:padding="6dp"
                android:src="@drawable/ic_qs_settings" />

            <ImageView
                android:id="@+id/btn_qs_collapse"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Collapse"
                android:padding="6dp"
                android:src="@drawable/ic_qs_collapse" />

            <!-- Power Button (hidden or minimal for ID parity) -->
            <ImageView
                android:id="@+id/btn_qs_power"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Power Menu"
                android:padding="6dp"
                android:visibility="gone"
                android:src="@drawable/ic_qs_power" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
