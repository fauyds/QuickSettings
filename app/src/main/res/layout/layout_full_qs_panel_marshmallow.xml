<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_full_qs_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Marshmallow Top Status Header (Dark Slate #263238) -->
    <LinearLayout
        android:id="@+id/ll_marshmallow_top_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#263238"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- Top status bar line: Carrier on Left, Battery + Settings + Profile on Right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_oreo_top_carrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Emergency calls only"
                android:textColor="#FFB0BEC5"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_oreo_top_battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="100%"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_oreo_top_battery_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Battery"
                    android:src="@drawable/ic_qs_battery"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/btn_qs_settings"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:padding="2dp"
                    android:src="@drawable/ic_qs_settings"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/iv_marshmallow_user"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="User Avatar"
                    android:src="@drawable/ic_qs_user"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Time & Date below status line -->
        <TextView
            android:id="@+id/tv_oreo_top_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="10:22 AM"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_qs_oreo_header_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Monday, October 26"
            android:textColor="#FFB0BEC5"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Main QS Body (Solid Slate #37474F) -->
    <LinearLayout
        android:id="@+id/ll_marshmallow_qs_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#37474F"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Brightness Slider Row -->
        <LinearLayout
            android:id="@+id/ll_qs_top_brightness_row"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_qs_top_brightness_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Brightness"
                android:src="@drawable/ic_qs_brightness_high"
                android:tint="#FFFFFFFF" />

            <SeekBar
                android:id="@+id/sb_qs_top_brightness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:min="5"
                android:paddingHorizontal="4dp"
                android:progress="128" />

            <FrameLayout
                android:id="@+id/fl_qs_top_brightness_icon_pill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_qs_top_brightness_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tiles RecyclerView (3 columns per row) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_qs_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Bottom Brightness (Hidden for ID parity) -->
        <LinearLayout
            android:id="@+id/ll_qs_bottom_brightness_row"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/sb_qs_bottom_brightness"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <FrameLayout
                android:id="@+id/fl_qs_bottom_brightness_icon_pill"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/iv_qs_bottom_brightness_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="Brightness" />

            <TextView
                android:id="@+id/tv_qs_bottom_brightness_percentage"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <!-- Footer Controls Row -->
        <RelativeLayout
            android:id="@+id/rl_qs_footer_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_qs_oreo_footer_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_qs_page_indicators"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/ll_qs_footer_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_qs_edit_mode"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Edit"
                    android:padding="6dp"
                    android:src="@drawable/ic_qs_edit"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/btn_qs_collapse"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Collapse"
                    android:padding="6dp"
                    android:src="@drawable/ic_qs_collapse"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/btn_qs_power"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Power"
                    android:padding="6dp"
                    android:src="@drawable/ic_qs_power"
                    android:tint="#FFFFFFFF" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
