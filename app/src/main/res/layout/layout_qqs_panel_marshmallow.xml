<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_qqs_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#263238"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Marshmallow Compact Top Status Header -->
    <RelativeLayout
        android:id="@+id/rl_marshmallow_qqs_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left: Time (Line 1) & Date (Line 2) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_oreo_top_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2:48 PM"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_qqs_oreo_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Saturday, September 5"
                android:textColor="#FFB0BEC5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right: Network Status, Battery, User Profile Avatar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_marshmallow_top_wifi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Wi-Fi"
                android:src="@drawable/ic_qs_wifi"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/iv_marshmallow_top_signal"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Signal"
                android:src="@drawable/ic_qs_cellular"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tv_oreo_top_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="100%"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_oreo_top_battery_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Battery"
                android:src="@drawable/ic_qs_battery"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/iv_marshmallow_top_user"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="User Avatar"
                android:src="@drawable/ic_qs_user"
                android:tint="#FFFFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Hidden compatibility elements for View ID parity -->
    <LinearLayout
        android:id="@+id/ll_qqs_brightness_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/fl_qqs_brightness_icon_pill"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <ImageView
                android:id="@+id/iv_qqs_brightness_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="Brightness" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/sb_qqs_brightness"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tv_qqs_brightness_percentage"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_qqs_tiles_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fl_qqs_drag_handle_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <View
            android:id="@+id/v_qqs_drag_handle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_oreo_top_carrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
