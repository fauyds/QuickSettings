<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_cat_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_notif_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <FrameLayout
            android:id="@+id/fl_cat_icon_bg"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/iv_cat_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_cat_label" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_cat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Category"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cat_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:minWidth="24dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_cat_expand"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Toggle category"
            android:padding="2dp"
            android:src="@drawable/ic_notif_chevron_down" />
    </LinearLayout>
</FrameLayout>
