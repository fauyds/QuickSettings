<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_notif_card"
    android:clipToOutline="true"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Leading Avatar / App Icon -->
        <FrameLayout
            android:id="@+id/fl_notif_icon_container"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/iv_notif_avatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/iv_notif_sub_app_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:background="#66000000"
                android:contentDescription="@null"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Notification Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Header Row: App Name + Time + Expand + Dismiss + More -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_notif_app_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFAAAAAA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_notif_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#88888888"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iv_notif_expand"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Expand"
                    android:padding="5dp"
                    android:src="@drawable/ic_notif_chevron_down"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_notif_dismiss"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Dismiss"
                    android:padding="6dp"
                    android:src="@drawable/ic_notif_close" />

                <ImageView
                    android:id="@+id/iv_notif_more"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Options"
                    android:padding="5dp"
                    android:src="@drawable/ic_notif_more" />
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Body Text -->
            <TextView
                android:id="@+id/tv_notif_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFD0D7DE"
                android:textSize="12sp" />

            <!-- SubText -->
            <TextView
                android:id="@+id/tv_notif_subtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFAAAAAA"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- BigPicture Attachment Image -->
            <ImageView
                android:id="@+id/iv_notif_big_picture"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp"
                android:adjustViewBounds="true"
                android:contentDescription="Attachment"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Action Buttons Container -->
            <LinearLayout
                android:id="@+id/ll_notif_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
