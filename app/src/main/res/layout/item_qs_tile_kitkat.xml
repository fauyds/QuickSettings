<?xml version="1.0" encoding="utf-8"?>
<com.example.ui.tile.TileRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_tile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.example.ui.tile.SquareTileLayout
        android:id="@+id/fl_kitkat_tile_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="1.5dp"
        android:background="#222222"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp">

            <!-- Tile Icon Container (Jetpack Compose) -->
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_tile_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center" />

            <!-- Label -->
            <TextView
                android:id="@+id/tv_tile_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tv_tile_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#888888"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.example.ui.tile.SquareTileLayout>
</com.example.ui.tile.TileRootLayout>
