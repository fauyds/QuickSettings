<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_qqs_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="0dp">

    <!-- Oreo Top Status Bar Row (Carrier on Left, Battery % + Icon + Time on Right) -->
    <LinearLayout
        android:id="@+id/ll_oreo_top_status_bar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tv_oreo_top_carrier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Carrier"
            android:textColor="#FF444444"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_oreo_top_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="100%"
                android:textColor="#FF444444"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_oreo_top_battery_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Battery"
                android:src="@drawable/ic_qs_battery" />

            <TextView
                android:id="@+id/tv_oreo_top_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21:25"
                android:textColor="#FF444444"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compatibility Brightness Slider Row (Optional in QQS) -->
    <LinearLayout
        android:id="@+id/ll_qqs_brightness_row"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/fl_qqs_brightness_icon_pill"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_qqs_brightness_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Brightness"
                android:src="@drawable/ic_qs_brightness_low" />
        </FrameLayout>

        <SeekBar
            android:id="@+id/sb_qqs_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="255"
            android:min="5"
            android:paddingHorizontal="10dp"
            android:progress="128" />

        <TextView
            android:id="@+id/tv_qqs_brightness_percentage"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:text="50%"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Oreo QQS 6 Tiles Row (Single horizontal clean row) -->
    <LinearLayout
        android:id="@+id/ll_qqs_tiles_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationY="-4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp" />

    <!-- Tile Line Separator in QQS (Edge-to-edge) -->
    <View
        android:id="@+id/v_qqs_oreo_tiles_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="-14dp"
        android:layout_marginEnd="-14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:background="#33888888" />

    <!-- Oreo QQS Subheader Row (Date/Alarm on Left, Actions & Expand Chevron on Right) -->
    <RelativeLayout
        android:id="@+id/rl_qqs_oreo_subheader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <!-- Left: Date and Alarm -->
        <LinearLayout
            android:id="@+id/ll_qqs_oreo_date_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_qqs_oreo_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thu, Oct 26"
                android:textColor="#FF666666"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/iv_qqs_oreo_alarm"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Alarm"
                android:visibility="gone"
                android:src="@drawable/ic_qs_alarm" />
        </LinearLayout>

        <!-- Right: Action Icons (Settings, Edit, Expand Chevron) -->
        <LinearLayout
            android:id="@+id/ll_qqs_oreo_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_qqs_oreo_settings"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="6dp"
                android:src="@drawable/ic_qs_settings" />

            <ImageView
                android:id="@+id/btn_qqs_oreo_edit"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit"
                android:padding="6dp"
                android:src="@drawable/ic_qs_edit" />

            <!-- Expand Chevron Container (Preserves fl_qqs_drag_handle_container and v_qqs_drag_handle for swipe/click parity) -->
            <FrameLayout
                android:id="@+id/fl_qqs_drag_handle_container"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <View
                    android:id="@+id/v_qqs_drag_handle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_qqs_oreo_expand"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Expand Quick Settings"
                    android:src="@drawable/ic_qs_expand" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
