<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_unified_qs_host_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fauyds.quicksettings.ui.tile.QuickQuickSettingsView
        android:id="@+id/view_qqs_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible" />

    <com.fauyds.quicksettings.ui.tile.QuickSettingsFullView
        android:id="@+id/view_full_qs_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.fauyds.quicksettings.ui.tile.TileEditStudioView
        android:id="@+id/view_tile_edit_studio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
