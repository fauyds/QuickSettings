<?xml version="1.0" encoding="utf-8"?>
<com.example.ui.tile.TileRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_tile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Tile Icon Circle / Rounded Square Container -->
    <FrameLayout
        android:id="@+id/fl_tile_icon_bg"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/iv_tile_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <!-- Remove / Add Action Badge for Edit Mode -->
        <ImageView
            android:id="@+id/iv_tile_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="1dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Action badge"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Title + Subtitle Text Wrapper Container -->
    <LinearLayout
        android:id="@+id/ll_labels_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="3dp">

        <!-- Label -->
        <TextView
            android:id="@+id/tv_tile_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Tile"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:clipChildren="false" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_tile_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Off"
            android:textColor="#FFAAAAAA"
            android:includeFontPadding="false"
            android:textSize="9.5sp"
            android:clipChildren="false" />
    </LinearLayout>
</com.example.ui.tile.TileRootLayout>
